{
	"name": "terraviz-wordpress-plugin",
	"version": "0.4.0",
	"description": "Embed live Terraviz \"Science On a Sphere\" globes into WordPress, plus an optional dashboard to publish and manage Terraviz datasets.",
	"author": "Zyra Project",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"gutenberg",
		"terraviz",
		"noaa",
		"embed"
	],
	"homepage": "https://github.com/zyra-project/terraviz-wordpress-plugin",
	"repository": {
		"type": "git",
		"url": "https://github.com/zyra-project/terraviz-wordpress-plugin.git"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks",
		"package": "npm run build && bash bin/build-zip.sh",
		"check:version": "bash bin/check-version.sh",
		"start": "wp-scripts start --webpack-src-dir=blocks",
		"format": "wp-scripts format ./blocks",
		"lint:js": "wp-scripts lint-js ./blocks",
		"lint:css": "wp-scripts lint-style ./blocks/**/*.css",
		"packages-update": "wp-scripts packages-update",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:e2e": "playwright test",
		"screenshots": "playwright test",
		"screenshots:update": "playwright test --update-snapshots",
		"visual-report": "node tests/e2e/visual-report.js"
	},
	"devDependencies": {
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^30.0.0",
		"pixelmatch": "^5.3.0",
		"pngjs": "^7.0.0"
	},
	"dependencies": {
		"easymde": "^2.21.0"
	},
	"comment:overrides": "Security patches for transitive dev-only dependencies that @wordpress/scripts and @wordpress/env still pin to vulnerable ranges. All are build/test tooling; none ship in the plugin ZIP. Drop an entry once upstream bumps it. The exception is \"@wordpress/env\": \"$@wordpress/env\", which points @wordpress/scripts 30's optional peer (^10) at the root's wp-env 11 so `npm ci` resolves; drop it if wp-scripts moves to 32+, which accepts >=10.",
	"overrides": {
		"@babel/core": "^7.29.7",
		"@opentelemetry/core": "^2.10.0",
		"@sentry/node": "^10.54.0",
		"@simple-git/argv-parser": "^2.0.1",
		"@wordpress/env": "$@wordpress/env",
		"adm-zip": "^0.6.1",
		"basic-ftp": "^6.2.3",
		"body-parser": "^1.20.6",
		"brace-expansion@2": "^2.1.7",
		"linkify-it": "^5.0.2",
		"markdown-it": "^14.3.1",
		"minimatch@3": "^3.1.5",
		"minimatch@9": "^9.0.9",
		"postcss-selector-parser": "^7.1.6",
		"qs": "^6.16.0",
		"serialize-javascript": "^7.0.7",
		"uuid": "^11.1.1",
		"webpack-dev-server": "^5.2.6"
	}
}
